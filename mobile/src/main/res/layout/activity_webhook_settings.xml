<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/webhook_description" android:layout_marginBottom="16dp" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/webhook_enabled"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/webhook_enable" />
        <EditText android:id="@+id/webhook_url" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/webhook_url_hint" android:inputType="textUri" android:autofillHints=""
            android:importantForAutofill="no" android:singleLine="true" android:layout_marginTop="16dp" />
        <EditText android:id="@+id/webhook_token" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/webhook_token_hint" android:inputType="textPassword" android:autofillHints=""
            android:importantForAutofill="no" android:singleLine="true" />
        <Button android:id="@+id/webhook_save" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/webhook_save" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/webhook_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textIsSelectable="true" android:layout_marginTop="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/via_tracking_setup" android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>

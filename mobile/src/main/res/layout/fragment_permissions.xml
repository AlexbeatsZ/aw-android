<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="权限"
        android:textSize="24sp"
        android:layout_gravity="center"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/varela_round"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="记录手机使用需要以下权限。只有第一项是必需的。"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginVertical="30dp"
        >


    <!-- Usage Access Permission -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="使用情况访问"
        android:textSize="16sp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/checkmarkUsage"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_x"
            android:paddingEnd="10dp"
            />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="必需：记录应用使用时长和解锁次数。"
                android:paddingTop="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnGrantUsagePermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="授权" />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"/>

    <!-- Accessibility Permission -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="无障碍"
        android:textSize="16sp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/checkmarkAccessibility"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_x"
            android:paddingEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="可选：记录浏览器（包括 Via）的网址和标题。"
                android:paddingTop="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnGrantAccessibilityPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="授权" />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"/>

    <!-- Exact Alarm Permission (for Widgets) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="精确闹钟"
        android:textSize="16sp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/checkmarkExactAlarm"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_x"
            android:paddingEnd="10dp"
            android:contentDescription=""
            android:importantForAccessibility="no"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="可选：让后台记录更准时。"
                android:paddingTop="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnGrantExactAlarmPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="授权" />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"/>

    <!-- Notification Access Permission (for Media Watcher) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="通知使用权"
        android:textSize="16sp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/checkmarkNotification"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_x"
            android:paddingEnd="10dp"
            android:contentDescription=""
            android:importantForAccessibility="no"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="可选：记录媒体播放（音乐、播客、视频）。"
                android:paddingTop="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnGrantNotificationPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="授权" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
